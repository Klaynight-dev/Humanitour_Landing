# Base de donnees
#
# PostgreSQL, en developpement comme en production : c'est le meme moteur que
# celui qui sert les donnees publiees, avec les memes types et le meme
# comportement transactionnel.
#
# Developpement : `bun run services:up` demarre le PostgreSQL de docker-compose,
# puis `bun run setup` applique les migrations et amorce le jeu de donnees.
DATABASE_URL="postgresql://humanitour:humanitour@127.0.0.1:5432/humanitour?schema=public"

# Production : la base est jointe par le reseau de docker-compose, donc par le
# nom du service et non par 127.0.0.1.
# DATABASE_URL="postgresql://humanitour:humanitour@db:5432/humanitour?schema=public"

# Sessions : 64 caracteres hexadecimaux. Generer avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-64-caracteres-hexadecimaux"

# Stockage des fichiers deposes (medias, imports)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./var/storage"

# Origine publique, utilisee pour les permaliens et les metadonnees Open Graph
PUBLIC_SITE_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Openforms : le SEUL canal de collecte (decision 3 de CLAUDE.md, revisee)
# ---------------------------------------------------------------------------
#
# Sans ces deux variables, aucune enquete ne peut recevoir de reponse : il n y a
# plus de depot de fichier, plus de saisie manuelle, plus d API d ingestion.
#
# La cle est une cle d API Openforms, prefixee « ofk_ », creee depuis le compte
# qui a acces aux formulaires de l enquete. Openforms n en conserve que le
# SHA-256 : si elle est perdue, il faut en creer une autre.
#
# Elle vaut les droits de son proprietaire : utiliser un compte qui ne voit QUE
# les formulaires de l enquete, jamais un super-administrateur. Elle ne sert
# qu a LIRE ; les reponses deposees depuis ce site partent sans identite.
OPENFORMS_URL="https://forms.humanitour.fr"
OPENFORMS_API_KEY=""

# Periode de la synchronisation planifiee, en minutes. Defaut : 15.
#
# Elle rattrape ce que le webhook a manque : notification perdue, panne reseau,
# reponse corrigee dans le tableur d Openforms. Mettre 0 la desactive, ce qui
# est le reglage attendu en developpement — interroger l instance de production
# toutes les quinze minutes depuis un poste n a aucun interet.
OPENFORMS_SYNC_MINUTES="15"

# Jeton du webhook de soumission.
#
# A renseigner dans les reglages de CHAQUE formulaire Openforms, champ
# « Webhook » :
#   https://humanitour.fr/api/openforms/webhook?jeton=<ce jeton>
#
# Il n authentifie PAS la donnee : le corps du webhook n est jamais cru, il ne
# sert que de signal, et la synchronisation relit ensuite les reponses chez
# Openforms avec la cle ci-dessus. Ce jeton limite seulement qui peut declencher
# une passe. Laisse vide, la route repond 503 et seule la minuterie travaille.
#
# Generer avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPENFORMS_WEBHOOK_TOKEN=""
