# Base de donnees
#
# PostgreSQL, en developpement comme en production : c'est le meme moteur que
# celui qui sert les donnees publiees, avec les memes types et le meme
# comportement transactionnel.
#
# Developpement : `bun run services:up` demarre le PostgreSQL de docker-compose,
# puis `bun run setup` applique les migrations et amorce le jeu de donnees.
DATABASE_URL="postgresql://humanitour:humanitour@127.0.0.1:5432/humanitour?schema=public"

# Production : la base est jointe par le reseau de docker-compose, donc par le
# nom du service et non par 127.0.0.1.
# DATABASE_URL="postgresql://humanitour:humanitour@db:5432/humanitour?schema=public"

# Sessions : 64 caracteres hexadecimaux. Generer avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-64-caracteres-hexadecimaux"

# Stockage des fichiers deposes (medias, imports)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./var/storage"

# Origine publique, utilisee pour les permaliens et les metadonnees Open Graph
PUBLIC_SITE_URL="http://localhost:5173"

# Connecteur d'ingestion depuis forms.humanitour.fr (optionnel)
# INGEST_API_TOKEN=""

# Connecteur Openforms (forms.humanitour.fr), decision 3 de CLAUDE.md
#
# La cle est une cle d API Openforms, prefixee « ofk_ », creee depuis le compte
# qui a acces aux formulaires de l enquete. Openforms n en conserve que le
# SHA-256 : si elle est perdue, il faut en creer une autre.
#
# Elle vaut les droits de son proprietaire : utiliser un compte qui ne voit QUE
# les formulaires de l enquete, jamais un super-administrateur.
OPENFORMS_URL="https://forms.humanitour.fr"
OPENFORMS_API_KEY=""
