// Domaine contenu editorial.
//
// Les pages publiques sont composees de sections editables. La base est la
// source de ce que le site affiche : supprimer une section la fait disparaitre
// pour de bon.
//
// Rien n'est perdu pour autant. Le modele d'origine de chaque page vit dans le
// depot (`src/lib/shared/content/templates/`) et se reapplique en un geste
// depuis le back-office : c'est ce qui permet d'editer sans filet sans editer
// sans retour.

enum ContentPageKey {
  HOME
  ABOUT
  TOUR
  METHOD
  GALLERY
  DATA
  MEDIA
  ANSWER
}

enum ContentPageStatus {
  DRAFT
  PUBLISHED
}

model ContentPage {
  id String @id @default(cuid())

  /// Enum et non cle de registre : la liste des pages editables est un choix
  /// produit ferme, pas une famille de variantes amenee a s'etendre souvent.
  key ContentPageKey @unique

  status      ContentPageStatus @default(DRAFT)
  publishedAt DateTime?

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  blocks ContentBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentBlock {
  id String @id @default(cuid())

  pageId String
  page   ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Cle du registre `src/lib/shared/content/blocks/`. Contrat : jamais renommee.
  type String

  position Int

  /// Champs propres au type de section, valides par le registre. Aucune colonne
  /// ne s'ajoute en base quand un type de section apparait (AGENTS.md § 2).
  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}
