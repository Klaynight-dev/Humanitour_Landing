// Point d'entree du schema. Les modeles vivent dans les fichiers voisins,
// un par domaine metier (AGENTS.md section 2).

// Generateur « prisma-client » et non « prisma-client-js » : ce dernier emet du
// CommonJS, que le runner ESM de Vite refuse de charger en developpement
// (« module is not defined »).
generator client {
  provider     = "prisma-client"
  output       = "../../src/lib/server/prisma-client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
